{
  "name": "@trawl/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1 --port 1421",
    "generate": "nuxt generate",
    "build": "nuxt generate",
    "typecheck": "nuxt typecheck",
    "native:dev": "CARGO_BUILD_JOBS=2 tauri dev",
    "native:build": "CARGO_BUILD_JOBS=2 tauri build --no-bundle",
    "native:package": "CARGO_BUILD_JOBS=2 TAURI_BUNDLER_DMG_IGNORE_CI=true tauri build",
    "native:update:package": "CARGO_BUILD_JOBS=2 TAURI_BUNDLER_DMG_IGNORE_CI=true tauri build --config src-tauri/tauri.updater.conf.json",
    "mobile:assets": "bun scripts/mobile-assets.ts",
    "android:build": "CARGO_BUILD_JOBS=2 tauri android build --apk --target aarch64 armv7 --split-per-abi --ci"
  },
  "dependencies": {
    "@iconify-json/lucide": "1.2.158",
    "@nuxt/ui": "4.13.0",
    "@pinia/nuxt": "1.0.3",
    "@tauri-apps/api": "2.12.5",
    "@tauri-apps/plugin-autostart": "2.7.0",
    "@trawl/client": "workspace:*",
    "@trawl/config": "workspace:*",
    "@vueuse/nuxt": "15.0.0",
    "lenis": "1.3.27",
    "nuxt": "4.6.4",
    "pinia": "^4.1.0",
    "tailwindcss": "4.3.5",
    "vue": "3.5.46"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.6",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.14",
    "@types/bun": "^1.4.5"
  }
}
