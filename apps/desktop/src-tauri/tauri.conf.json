{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TRAWL",
  "version": "0.1.0",
  "identifier": "com.germondai.trawl.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run generate",
    "devUrl": "http://127.0.0.1:1421",
    "frontendDist": "../.output/public"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TRAWL",
        "width": 1180,
        "height": 820,
        "minWidth": 480,
        "minHeight": 540,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "acceptFirstMouse": true,
        "dragDropEnabled": false,
        "visible": false,
        "backgroundColor": "#1c1c1e"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; connect-src ipc: http://ipc.localhost; font-src 'self' data:; object-src 'none'; frame-src blob:; base-uri 'self'; form-action 'none'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost ws://127.0.0.1:1421 http://127.0.0.1:1421; font-src 'self' data:; object-src 'none'; frame-src blob:; base-uri 'self'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM3RThDODM3NkQ4NzZBQjcKUldTM2FvZHROOGpvTitqaFcxZ1gzRFI0SSs5N29DVjNmd0N1UUxPZjRlY2ZPb2kxMmNmOHpCa0EK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../../../.artifacts/v2/runtime/": "runtime/"
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "dmg": {
        "background": "resources/dmg-background.tiff",
        "windowSize": { "width": 660, "height": 480 },
        "appPosition": { "x": 180, "y": 205 },
        "applicationFolderPosition": { "x": 480, "y": 205 }
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
